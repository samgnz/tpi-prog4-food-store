# Conexión a la base de datos (PostgreSQL o SQLite para desarrollo local)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma y configuración del JWT (SECRET_KEY mínimo 32 caracteres)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173