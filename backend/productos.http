@baseUrl = http://127.0.0.1:8000

### ==========================================
### 1. MÓDULO: CATEGORÍAS (CRUD Completo)
### ==========================================

### 1.1 Crear Categoría 1 (Pizzas)
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "Pizzas",
  "descripcion": "Pizzas artesanales con masa fresca"
}

### 1.2 Crear Categoría 2 (Hamburguesas)
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "Hamburguesas",
  "descripcion": "Hamburguesas gourmet con ingredientes frescos"
}

### 1.3 Crear Categoría 3 (Bebidas - para probar eliminar)
POST {{baseUrl}}/categorias
Content-Type: application/json

{
  "nombre": "Bebidas",
  "descripcion": "Gaseosas, jugos naturales y agua"
}

### 1.4 Listar todas las Categorías
GET {{baseUrl}}/categorias

### 1.5 Obtener detalle de Categoría por ID
GET {{baseUrl}}/categorias/1

### 1.6 Actualizar Categoría (PUT)
PUT {{baseUrl}}/categorias/1
Content-Type: application/json

{
  "nombre": "Pizzas",
  "descripcion": "Pizzas artesanales a la piedra con masa madre"
}

### 1.7 Eliminar Categoría (DELETE)
DELETE {{baseUrl}}/categorias/3


### ==========================================
### 2. MÓDULO: PRODUCTOS (CRUD Completo)
### ==========================================

### 2.1 Crear Producto (asociando categoría inicial opcional)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Pizza Muzzarella",
  "descripcion": "Salsa de tomate, muzzarella y aceitunas verdes",
  "precio_base": 12500.0,
  "imagenes_url": [
    "https://ejemplo.com/img/pizza-muzzarella.jpg"
  ],
  "disponible": true,
  "categoria_ids": [1]
}

### 2.2 Crear segundo Producto (sin categorías iniciales)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Hamburguesa Doble Cheddar",
  "descripcion": "Doble medallón de carne, cheddar y panceta",
  "precio_base": 10800.0,
  "imagenes_url": [
    "https://ejemplo.com/img/burger-doble.jpg"
  ],
  "disponible": true
}

### 2.3 Listar todos los Productos
GET {{baseUrl}}/productos

### 2.4 Obtener detalle de un Producto por ID (incluye sus categorías)
GET {{baseUrl}}/productos/1

### 2.5 Actualizar un Producto (PUT)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "nombre": "Pizza Muzzarella Especial",
  "descripcion": "Salsa de tomate casera, doble muzzarella, orégano y aceitunas",
  "precio_base": 13500.0,
  "imagenes_url": [
    "https://ejemplo.com/img/muzzarella-especial.jpg"
  ],
  "disponible": true
}


### ==========================================
### 3. RELACIÓN: PRODUCTO_CATEGORIA (N:M)
### ==========================================

### 3.1 Asociar Categoría 2 al Producto 2 (POST /productos/{id}/categorias)
POST {{baseUrl}}/productos/2/categorias
Content-Type: application/json

{
  "categoria_id": 2
}

### 3.2 Asociar también Categoría 1 al Producto 2 (un producto con múltiples categorías)
POST {{baseUrl}}/productos/2/categorias
Content-Type: application/json

{
  "categoria_id": 1
}

### 3.3 Listar Categorías asociadas al Producto 2 (GET /productos/{id}/categorias)
GET {{baseUrl}}/productos/2/categorias

### 3.4 Desasociar Categoría 1 del Producto 2 (DELETE /productos/{id}/categorias/{categoria_id})
DELETE {{baseUrl}}/productos/2/categorias/1


### ==========================================
### 4. MÓDULO: INGREDIENTES (CRUD Completo - HU-05)
### ==========================================

### 4.1 Crear Ingrediente 1 (Muzzarella) (201 Created)
POST {{baseUrl}}/ingredientes
Content-Type: application/json

{
  "nombre": "Queso Muzzarella"
}

### 4.2 Crear Ingrediente 2 (Salsa de Tomate) (201 Created)
POST {{baseUrl}}/ingredientes
Content-Type: application/json

{
  "nombre": "Salsa de Tomate"
}

### 4.3 Crear Ingrediente 3 (Aceitunas Verdes - para eliminar) (201 Created)
POST {{baseUrl}}/ingredientes
Content-Type: application/json

{
  "nombre": "Aceitunas Verdes"
}

### 4.4 Listar todos los Ingredientes (200 OK)
GET {{baseUrl}}/ingredientes

### 4.5 Obtener detalle de Ingrediente por ID (200 OK)
GET {{baseUrl}}/ingredientes/1

### 4.6 Actualizar Ingrediente (PUT) (200 OK)
PUT {{baseUrl}}/ingredientes/1
Content-Type: application/json

{
  "nombre": "Queso Muzzarella Premium"
}

### 4.7 Error 422 — Nombre de ingrediente vacío o solo espacios (RN-10)
POST {{baseUrl}}/ingredientes
Content-Type: application/json

{
  "nombre": "    "
}

### 4.8 Error 409 — Nombre de ingrediente duplicado sin distinción de mayúsculas (RN-10)
POST {{baseUrl}}/ingredientes
Content-Type: application/json

{
  "nombre": "salsa de tomate"
}

### 4.9 Eliminar Ingrediente (DELETE) (204 No Content)
DELETE {{baseUrl}}/ingredientes/3

### 4.10 Error 404 — Operar sobre ingrediente inexistente (RN-11)
GET {{baseUrl}}/ingredientes/9999
